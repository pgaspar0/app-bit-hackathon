# ============================================================
# .env.example — BiT App / Equipa 48
# ============================================================
# Como usar:
#   cp .env.example .env
#   Edita o .env com os valores reais
#   NUNCA commitas o .env — está no .gitignore
# ============================================================

# --- Base de dados ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bitapp
DB_USER=bit
DB_PASSWORD=bit

# --- Caminhos dos dados (dataset Vísent CDRView) ---
# Ajusta conforme onde clonaste o repositório dataset
DATA_DIR=../dataset-visent
REFERENCIAS_DIR=${DATA_DIR}/referencias
TENSORES_DIR=${DATA_DIR}/tensores

# --- Ambiente ---
# 'development' | 'production'
APP_ENV=development

# --- IA (Hércules preenche) ---
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
AI_SERVICE_URL=